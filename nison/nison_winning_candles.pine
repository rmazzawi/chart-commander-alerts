// Book 3: "11 Winning Candlestick Patterns" (Part 1) - from Steve Nison's Japanese Candlestick Charting Techniques
// Patterns covered in Part 1: Doji (regular / gravestone / long-legged / dragonfly), Engulfing,
// Doji Star (with next-session confirmation), Evening Doji Star (+ its mirror, Morning Doji Star)
//@version=5
indicator("Nison Winning Candles", overlay = true, max_labels_count = 500)

dojiPct  = input.float(10, "Doji: body max % of candle range", step = 1)
trendLen = input.int(10, "Trend lookback (bars)", minval = 3)
showDoji = input.bool(true, "Mark plain Doji lines (no trade signal)")
confirm  = input.bool(true, "Doji Star needs confirmation next session (Nison)")

body  = math.abs(close - open)
rng   = high - low
upW   = high - math.max(open, close)
loW   = math.min(open, close) - low
avgB  = ta.sma(body, 14)
bull  = close > open
bear  = close < open
isLong(i) => body[i] > avgB[i] * 1.2
ma = ta.sma(close, trendLen)
upTrend   = close > ma and ma > ma[3]
downTrend = close < ma and ma < ma[3]

// 1. Doji varieties
doji       = rng > 0 and body <= rng * dojiPct / 100
gravestone = doji and loW <= rng * 0.1 and upW >= rng * 0.7
dragonfly  = doji and upW <= rng * 0.1 and loW >= rng * 0.7
longLegged = doji and not gravestone and not dragonfly and rng > ta.sma(rng, 14) * 1.3

plotshape(showDoji and gravestone, "Gravestone Doji", shape.triangledown, location.abovebar, color.new(color.orange, 0), size = size.tiny, text = "GD")
plotshape(showDoji and dragonfly, "Dragonfly Doji", shape.triangleup, location.belowbar, color.new(color.aqua, 0), size = size.tiny, text = "DD")
plotshape(showDoji and longLegged, "Long-Legged Doji", shape.cross, location.abovebar, color.new(color.gray, 0), size = size.tiny, text = "LL")
plotshape(showDoji and doji and not gravestone and not dragonfly and not longLegged, "Doji", shape.cross, location.abovebar, color.new(color.gray, 40), size = size.tiny)

// 2. Engulfing: large real body engulfs a small opposite real body, in a trend
bullEng = downTrend[1] and bear[1] and bull and close > open[1] and open < close[1] and body > body[1]
bearEng = upTrend[1] and bull[1] and bear and close < open[1] and open > close[1] and body > body[1]

// 3. Doji Star: doji that gaps away from a long candle; confirmed next session
bearDojiStar = upTrend[1] and bull[1] and isLong(1) and doji and math.min(open, close) > close[1]
bullDojiStar = downTrend[1] and bear[1] and isLong(1) and doji and math.max(open, close) < close[1]
bearDSConf = confirm ? (bearDojiStar[1] and bear and close < low[1]) : bearDojiStar
bullDSConf = confirm ? (bullDojiStar[1] and bull and close > high[1]) : bullDojiStar

// 4. Evening Doji Star: long white, doji gapping up, then black candle closing deep into the first body
eveDojiStar  = upTrend[2] and bull[2] and isLong(2) and doji[1] and math.min(open[1], close[1]) > close[2] and bear and close < (open[2] + close[2]) / 2
mornDojiStar = downTrend[2] and bear[2] and isLong(2) and doji[1] and math.max(open[1], close[1]) < close[2] and bull and close > (open[2] + close[2]) / 2

bullSig = bullEng or (bullDSConf and not mornDojiStar) or mornDojiStar
bearSig = bearEng or (bearDSConf and not eveDojiStar) or eveDojiStar
bullName = mornDojiStar ? "Morning Doji Star" : bullEng ? "Bullish Engulfing" : "Doji Star (bull)"
bearName = eveDojiStar ? "Evening Doji Star" : bearEng ? "Bearish Engulfing" : "Doji Star (bear)"

// Stop: beyond the pattern's extreme (lowest low / highest high of last 3 candles). Target: 2x risk.
lo3 = ta.lowest(low, 3)
hi3 = ta.highest(high, 3)
if bullSig
    stop = lo3
    tgt  = close + 2 * (close - stop)
    label.new(bar_index, low, bullName + "\nStop " + str.tostring(stop, format.mintick) + "\n2R " + str.tostring(tgt, format.mintick), style = label.style_label_up, yloc = yloc.belowbar, color = color.new(color.green, 10), textcolor = color.white, size = size.small)
    alert(syminfo.ticker + " shows a " + bullName + " on the " + timeframe.period + " chart. Stop " + str.tostring(stop, format.mintick) + ".", alert.freq_once_per_bar_close)
if bearSig
    stop = hi3
    tgt  = close - 2 * (stop - close)
    label.new(bar_index, high, bearName + "\nStop " + str.tostring(stop, format.mintick) + "\n2R " + str.tostring(tgt, format.mintick), style = label.style_label_down, yloc = yloc.abovebar, color = color.new(color.red, 10), textcolor = color.white, size = size.small)
    alert(syminfo.ticker + " shows a " + bearName + " on the " + timeframe.period + " chart. Stop " + str.tostring(stop, format.mintick) + ".", alert.freq_once_per_bar_close)

alertcondition(bullSig, "Nison Bullish", "{{ticker}} bullish Nison pattern on {{interval}}")
alertcondition(bearSig, "Nison Bearish", "{{ticker}} bearish Nison pattern on {{interval}}")
