// Book 6: Alan Farley - "Targeting Profitable Entry & Exit Points" (Hard Right Edge)
// Ideas from the slides:
//  * Markets cycle: RANGE (box) -> TREND (breakout) -> RANGE ... trade the break out of the box
//  * Convergence: when several S/R tools stack at one price (Fib 38/50/62, whole numbers, moving averages,
//    Bollinger Bands, gaps) that zone is the EXECUTION ZONE
//  * Every trade has a PROFIT TARGET (next level) and a FAILURE TARGET (stop just past the zone)
//@version=5
indicator("Farley Convergence & Range Break", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

grpR = "Range -> Trend breakout"
useRange = input.bool(true, "Range breakout signals", group = grpR)
boxLen   = input.int(20, "Range length (bars)", minval = 5, group = grpR)
boxATR   = input.float(3.0, "Max range height (x ATR)", step = 0.5, group = grpR)
volMult  = input.float(1.5, "Breakout volume vs average (x)", step = 0.1, group = grpR)

grpC = "Convergence zone"
useConv  = input.bool(false, "Convergence bounce/rejection signals (TEST: loses after costs, off by default)", group = grpC)
swingLen = input.int(50, "Swing for Fibonacci grid (bars)", group = grpC)
zoneATR  = input.float(0.5, "Zone width (x ATR)", step = 0.1, group = grpC)
minHits  = input.int(3, "Min levels stacked in zone", minval = 2, maxval = 6, group = grpC)
roundStep = input.float(0, "Whole-number step ($, 0 = auto)", group = grpC)
showFib  = input.bool(true, "Draw Fibonacci grid", group = grpC)
showBB   = input.bool(true, "Show Bollinger Bands + 20/50 MA", group = grpC)

grpX = "Trade boxes"
minRR     = input.float(1.5, "Min reward / risk (green must be at least this x red, else no trade)", minval = 1.0, step = 0.25, group = grpX)
grpV = "BB Reversal (catch the turns) - TEST: ~36% wins, works best on AMD"
useBBR  = input.bool(false, "BB Reversal signals (poke outside the band -> close back inside -> break)", group = grpV)
bbrTks  = input.string("AMD", "BB Reversal only on these tickers (comma list, empty = all)", group = grpV)
bbrSess = input.session("0935-1530", "BB Reversal entry hours (New York)", group = grpV)
grpD = "Day High / Low Reversal to VWAP - TEST: ~33% wins, +0.07R after costs, calls at day low better"
useDR  = input.bool(true, "Day High/Low Reversal signals (no new high/low for N candles -> reverse to VWAP)", group = grpD)
drBars = input.int(6, "Candles without a new high / low", minval = 2, maxval = 20, group = grpD)
drSess = input.session("1030-1545", "Day Reversal entry hours (New York)", group = grpD)
drTks  = input.string("AAPL,AMD,AMZN,MSFT,NVDA,QQQ", "Day Reversal only on these tickers (comma list, empty = all)", group = grpD)
showBoxes = input.bool(true, "Show long / short boxes (green = profit, red = failure)", group = grpX)
showLines = input.bool(false, "Also draw the old profit / failure lines", group = grpX)
lblSizeIn = input.string("large", "Label text size", options = ["tiny", "small", "normal", "large", "huge"], group = grpX)
lblGap = input.float(3.0, "Label distance from the candle (x ATR, 0 = touching)", minval = 0, step = 0.5, group = grpX)
lblSize = lblSizeIn == "tiny" ? size.tiny : lblSizeIn == "small" ? size.small : lblSizeIn == "normal" ? size.normal : lblSizeIn == "huge" ? size.huge : size.large

atr = ta.atr(14)
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
[bbM, bbU, bbL] = ta.bb(close, 20, 2)
plot(showBB ? ma20 : na, "20 MA", color.new(color.teal, 20))
plot(showBB ? ma50 : na, "50 MA", color.new(color.blue, 20))
plot(showBB ? bbU : na, "BB upper", color.new(color.red, 50))
plot(showBB ? bbL : na, "BB lower", color.new(color.red, 50))

// ───────── Trade boxes (no text): green = entry -> profit target, red = entry -> failure target ─────────
// ONE TRADE AT A TIME: while a box is open, new signals are ignored until target, stop or end of day
var int   tDir  = 0
var int   tBar  = na
var float tE    = na
var float tF    = na
var float tP    = na
var box   bWin  = na
var box   bRisk = na
newDay = dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")
boxRTH = not na(time(timeframe.period, "0930-1600", "America/New_York")) or not timeframe.isintraday
// manage the open box: stretch until profit or failure target is hit, or 4 PM
if tDir != 0
    if newDay or not boxRTH
        tDir := 0
    else
        box.set_right(bWin, bar_index + 1)
        box.set_right(bRisk, bar_index + 1)
        if bar_index > tBar and (tDir == 1 ? (low <= tF or high >= tP) : (high >= tF or low <= tP))
            tDir := 0
busy = showBoxes and tDir != 0

// ───────── 1) Range -> Trend ─────────
rHi = ta.highest(high, boxLen)[1]
rLo = ta.lowest(low, boxLen)[1]
isRange = (rHi - rLo) <= boxATR * atr
volOK = volume > ta.sma(volume, 20) * volMult
boUp = useRange and isRange and close > rHi and close[1] <= rHi and volOK
boDn = useRange and isRange and close < rLo and close[1] >= rLo and volOK
// failure target just inside the broken edge; profit = measured move (box height). Skip if reward < minRR x risk
boFailL = rHi - 0.2 * atr
boFailS = rLo + 0.2 * atr
boProfL = rHi + (rHi - rLo)
boProfS = rLo - (rHi - rLo)
boUp := boUp and not busy and close > boFailL and (boProfL - close) >= minRR * (close - boFailL)
boDn := boDn and not busy and close < boFailS and (close - boProfS) >= minRR * (boFailS - close)

drawTrade(string name, bool isLong, float entry, float fail, float profit, string short = "") =>
    if showLines
        line.new(bar_index, fail, bar_index + 15, fail, color = color.red, width = 2)
        line.new(bar_index, profit, bar_index + 15, profit, color = color.green, width = 2, style = line.style_dashed)
    txt = short != "" ? short : name
    label.new(bar_index, isLong ? low - lblGap * atr : high + lblGap * atr, txt, yloc = yloc.price, style = isLong ? label.style_label_up : label.style_label_down, color = isLong ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = lblSize)
    alert(syminfo.ticker + " has a Farley " + name + " on the " + timeframe.period + " chart. Entry " + str.tostring(entry, format.mintick) + ", profit target " + str.tostring(profit, format.mintick) + ", failure target " + str.tostring(fail, format.mintick) + ".", alert.freq_once_per_bar_close)

if boUp
    box.new(bar_index - boxLen, rHi, bar_index - 1, rLo, border_color = color.gray, bgcolor = color.new(color.gray, 85))
    // failure target: back inside the box (mid-range); profit target: measured move = box height
    drawTrade("Range Breakout", true, close, boFailL, boProfL)
if boDn
    box.new(bar_index - boxLen, rHi, bar_index - 1, rLo, border_color = color.gray, bgcolor = color.new(color.gray, 85))
    drawTrade("Range Breakdown", false, close, boFailS, boProfS)

// ───────── 2) Convergence zones ─────────
swHi = ta.highest(high, swingLen)
swLo = ta.lowest(low, swingLen)
upLeg = ta.highestbars(high, swingLen) > ta.lowestbars(low, swingLen)   // high is more recent than low -> pullback from up leg
f38 = upLeg ? swHi - (swHi - swLo) * 0.382 : swLo + (swHi - swLo) * 0.382
f50 = (swHi + swLo) / 2
f62 = upLeg ? swHi - (swHi - swLo) * 0.618 : swLo + (swHi - swLo) * 0.618

step = roundStep > 0 ? roundStep : close < 10 ? 0.5 : close < 50 ? 1 : close < 200 ? 5 : 10
roundLvl = math.round(close / step) * step

// gap level: most recent unfilled-ish gap edge
var float gapLvl = na
if low > high[1]
    gapLvl := high[1]
if high < low[1]
    gapLvl := low[1]

zone = zoneATR * atr
hit(lvl, p) => not na(lvl) and math.abs(lvl - p) <= zone ? 1 : 0
hits(p) => hit(f38, p) + hit(f50, p) + hit(f62, p) + hit(roundLvl, p) + hit(ma20, p) + hit(ma50, p) + hit(bbL, p) + hit(bbU, p) + hit(gapLvl, p)

supHits = hits(low)
resHits = hits(high)

// Execution: candle tests the stacked zone and closes back out of it (reversal at the zone), in the direction of the bigger leg
convLong  = useConv and upLeg and supHits >= minHits and close > open and close > low + (high - low) * 0.5
convShort = useConv and not upLeg and resHits >= minHits and close < open and close < high - (high - low) * 0.5
convLong  := convLong and (swHi - close) >= minRR * (close - (low - zone))
convShort := convShort and (close - swLo) >= minRR * ((high + zone) - close)
convLong  := convLong and not convLong[1] and not boUp and not busy
convShort := convShort and not convShort[1] and not boDn and not busy

if convLong
    drawTrade("Convergence Bounce (" + str.tostring(supHits) + " levels)", true, close, low - zone, swHi, "Bounce " + str.tostring(supHits))
if convShort
    drawTrade("Convergence Rejection (" + str.tostring(resHits) + " levels)", false, close, high + zone, swLo, "Reject " + str.tostring(resHits))

// ───────── 3) BB Reversal: candle pokes outside the Bollinger Band, next candle closes back inside (colored the other way),
// entry when price breaks that candle within 2 candles; stop past the 3-candle extreme; target = middle band (min reward/risk)
bbrHours = not na(time(timeframe.period, bbrSess, "America/New_York")) and (str.length(str.trim(bbrTks)) == 0 or str.contains("," + str.replace_all(str.upper(bbrTks), " ", "") + ",", "," + syminfo.ticker + ","))
var float rvS_trig = na
var float rvS_stop = na
var int   rvS_bar  = na
var float rvL_trig = na
var float rvL_stop = na
var int   rvL_bar  = na
bbrS = false
bbrL = false
float bbrE = na
float bbrF = na
float bbrP = na
if useBBR and bbrHours
    if not na(rvS_bar) and bar_index > rvS_bar and bar_index <= rvS_bar + 2 and low < rvS_trig
        e = math.min(open, rvS_trig)
        if (e - bbM) >= minRR * (rvS_stop - e) and rvS_stop > e
            bbrS := true
            bbrE := e
            bbrF := rvS_stop
            bbrP := bbM
        rvS_bar := na
    if not na(rvL_bar) and bar_index > rvL_bar and bar_index <= rvL_bar + 2 and high > rvL_trig and not bbrS
        e = math.max(open, rvL_trig)
        if (bbM - e) >= minRR * (e - rvL_stop) and rvL_stop < e
            bbrL := true
            bbrE := e
            bbrF := rvL_stop
            bbrP := bbM
        rvL_bar := na
    if barstate.isconfirmed and high[1] > bbU[1] and close < bbU and close < open
        rvS_trig := low
        rvS_stop := math.max(high, high[1], high[2]) + 0.1 * atr
        rvS_bar  := bar_index
    if barstate.isconfirmed and low[1] < bbL[1] and close > bbL and close > open
        rvL_trig := high
        rvL_stop := math.min(low, low[1], low[2]) - 0.1 * atr
        rvL_bar  := bar_index
if not na(rvS_bar) and bar_index > rvS_bar + 2
    rvS_bar := na
if not na(rvL_bar) and bar_index > rvL_bar + 2
    rvL_bar := na
bbrS := bbrS and not busy
bbrL := bbrL and not busy and not bbrS
if bbrS
    label.new(bar_index, high + lblGap * atr, "BB Reversal", yloc = yloc.price, style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = lblSize)
    alert(syminfo.ticker + " BB Reversal PUTS on the " + timeframe.period + " chart. Entry " + str.tostring(bbrE, format.mintick) + ", stop " + str.tostring(bbrF, format.mintick) + ", target " + str.tostring(bbrP, format.mintick) + ".", alert.freq_once_per_bar)
if bbrL
    label.new(bar_index, low - lblGap * atr, "BB Reversal", yloc = yloc.price, style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = lblSize)
    alert(syminfo.ticker + " BB Reversal CALLS on the " + timeframe.period + " chart. Entry " + str.tostring(bbrE, format.mintick) + ", stop " + str.tostring(bbrF, format.mintick) + ", target " + str.tostring(bbrP, format.mintick) + ".", alert.freq_once_per_bar)

newDayD = dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")
// ───────── 4) Day High / Low Reversal: day high (low) not exceeded for N candles -> puts (calls) back to VWAP
// stop just past the day high (low); skip if VWAP is less than minRR x the stop away
dVW = ta.vwap(hlc3)
inRTHd = not na(time(timeframe.period, "0930-1600", "America/New_York"))
firstD = inRTHd and (not inRTHd[1] or newDayD)
inDR = not na(time(timeframe.period, drSess, "America/New_York")) and (str.length(str.trim(drTks)) == 0 or str.contains("," + str.replace_all(str.upper(drTks), " ", "") + ",", "," + syminfo.ticker + ","))
var float dHi = na
var float dLo = na
var int   kH  = na
var int   kL  = na
var bool  uH  = true
var bool  uL  = true
drS = false
drL = false
float drE = na
float drF = na
float drP = na
if inRTHd
    if firstD
        dHi := high
        dLo := low
        kH := bar_index
        kL := bar_index
        uH := false
        uL := false
    else
        if high > dHi
            dHi := high
            kH := bar_index
            uH := false
        if low < dLo
            dLo := low
            kL := bar_index
            uL := false
        if useDR and inDR and not uH and bar_index - kH == drBars
            uH := true
            if (close - dVW) >= minRR * (dHi + 0.1 * atr - close) and dHi + 0.1 * atr > close
                drS := true
                drE := close
                drF := dHi + 0.1 * atr
                drP := dVW
        if useDR and inDR and not uL and bar_index - kL == drBars and not drS
            uL := true
            if (dVW - close) >= minRR * (close - (dLo - 0.1 * atr)) and dLo - 0.1 * atr < close
                drL := true
                drE := close
                drF := dLo - 0.1 * atr
                drP := dVW
drS := drS and not busy
drL := drL and not busy
if drS
    label.new(bar_index, high + lblGap * atr, "Day High Rev", yloc = yloc.price, style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = lblSize)
    alert(syminfo.ticker + " Day High Reversal PUTS on the " + timeframe.period + " chart. Entry " + str.tostring(drE, format.mintick) + ", stop " + str.tostring(drF, format.mintick) + ", target VWAP " + str.tostring(drP, format.mintick) + ".", alert.freq_once_per_bar_close)
if drL
    label.new(bar_index, low - lblGap * atr, "Day Low Rev", yloc = yloc.price, style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = lblSize)
    alert(syminfo.ticker + " Day Low Reversal CALLS on the " + timeframe.period + " chart. Entry " + str.tostring(drE, format.mintick) + ", stop " + str.tostring(drF, format.mintick) + ", target VWAP " + str.tostring(drP, format.mintick) + ".", alert.freq_once_per_bar_close)

// open a new box on a signal (only when no box is open - signals are already blocked while busy)
nDir = boUp or convLong ? 1 : boDn or convShort ? -1 : bbrL ? 1 : bbrS ? -1 : drL ? 1 : drS ? -1 : 0
nE = bbrL or bbrS ? bbrE : close
if showBoxes and nDir != 0
    nF = boUp ? boFailL : boDn ? boFailS : convLong ? low - zone : convShort ? high + zone : bbrL or bbrS ? bbrF : drF
    nP = boUp ? boProfL : boDn ? boProfS : convLong ? swHi : convShort ? swLo : bbrL or bbrS ? bbrP : drP
    if (nP - nE) * nDir > 0 and (nE - nF) * nDir > 0
        tDir := nDir
        tBar := bar_index
        tE   := nE
        tF   := nF
        tP   := nP
        bWin  := box.new(bar_index, math.max(tE, tP), bar_index + 1, math.min(tE, tP), border_color = color.new(color.green, 0), bgcolor = color.new(color.green, 75))
        bRisk := box.new(bar_index, math.max(tE, tF), bar_index + 1, math.min(tE, tF), border_color = color.new(color.red, 0), bgcolor = color.new(color.red, 75))

// Fibonacci grid on the last bar
var line[] fibLines = array.new_line()
if showFib and barstate.islast
    for l in fibLines
        line.delete(l)
    array.clear(fibLines)
    for lvl in array.from(swHi, f38, f50, f62, swLo)
        array.push(fibLines, line.new(bar_index - swingLen, lvl, bar_index + 10, lvl, color = color.new(color.navy, 30)))

alertcondition(boUp, "Farley Range Breakout", "{{ticker}} range breakout on {{interval}}")
alertcondition(boDn, "Farley Range Breakdown", "{{ticker}} range breakdown on {{interval}}")
alertcondition(convLong, "Farley Convergence Long", "{{ticker}} convergence bounce on {{interval}}")
alertcondition(convShort, "Farley Convergence Short", "{{ticker}} convergence rejection on {{interval}}")
alertcondition(drL, "Farley Day Low Reversal", "{{ticker}} day low reversal (calls) on {{interval}}")
alertcondition(drS, "Farley Day High Reversal", "{{ticker}} day high reversal (puts) on {{interval}}")
