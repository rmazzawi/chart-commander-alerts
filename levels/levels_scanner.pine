//@version=6
// Chart Commander - Key Levels Scanner (PMH / PML / PDH / PDL / VWAP)
// Put on ONE chart (5min recommended, extended hours ON). Scans up to 20 tickers.
indicator("CC Levels Scanner", overlay = true)

listStr = input.string("SPY,QQQ,TSLA,NVDA,AAPL,AMD,META,AMZN,MSFT,GOOGL,CAVA,PLTR,CVNA,COIN,MSTR,CRWD,LULU,GLD,IWM", "Tickers (comma separated, max 20)")
syms = str.split(str.replace_all(listStr, " ", ""), ",")

// Runs inside each ticker's data
levels() =>
    var float pmh = na
    var float pml = na
    var float rthH = na
    var float rthL = na
    var float pdh = na
    var float pdl = na
    newDay = dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")
    if newDay
        pdh := rthH
        pdl := rthL
        pmh := na
        pml := na
        rthH := na
        rthL := na
    if not na(time(timeframe.period, "0400-0930", "America/New_York"))
        pmh := na(pmh) ? high : math.max(pmh, high)
        pml := na(pml) ? low : math.min(pml, low)
    if not na(time(timeframe.period, "0930-1600", "America/New_York"))
        rthH := na(rthH) ? high : math.max(rthH, high)
        rthL := na(rthL) ? low : math.min(rthL, low)
    [close, pmh, pml, pdh, pdl, ta.vwap(hlc3)]

get(i) =>
    s = i < array.size(syms) ? array.get(syms, i) : ""
    t = s == "" ? syminfo.tickerid : ticker.new("", s, session.extended)
    [c, a, b, d, e, v] = request.security(t, timeframe.period, levels())
    [s, c, a, b, d, e, v]

// numbers as text; a missing value is sent as null (NaN is not valid JSON and made n8n ignore the whole message)
num(x) => na(x) ? "null" : str.tostring(x, "#.##")

fmt(s, c, pmh, pml, pdh, pdl, v) =>
    sig = c > pdh ? "ABOVE PDH" : c < pdl ? "BELOW PDL" : c > pmh ? "ABOVE PMH" : c < pml ? "BELOW PML" : "INSIDE"
    '{"t":"' + s + '","price":' + num(c) + ',"pmh":' + num(pmh) + ',"pml":' + num(pml) + ',"pdh":' + num(pdh) + ',"pdl":' + num(pdl) + ',"vwap":' + num(v) + ',"side":"' + (c >= v ? "ABOVE" : "BELOW") + '","signal":"' + sig + '"}'

var rows = array.new_string()
array.clear(rows)
add(s, c, a, b, d, e, v) =>
    if s != ""
        array.push(rows, fmt(s, c, a, b, d, e, v))

// request.security must be called with fixed indexes (Pine rule), so 20 lines:
[s0,c0,a0,b0,d0,e0,v0] = get(0)
add(s0,c0,a0,b0,d0,e0,v0)
[s1,c1,a1,b1,d1,e1,v1] = get(1)
add(s1,c1,a1,b1,d1,e1,v1)
[s2,c2,a2,b2,d2,e2,v2] = get(2)
add(s2,c2,a2,b2,d2,e2,v2)
[s3,c3,a3,b3,d3,e3,v3] = get(3)
add(s3,c3,a3,b3,d3,e3,v3)
[s4,c4,a4,b4,d4,e4,v4] = get(4)
add(s4,c4,a4,b4,d4,e4,v4)
[s5,c5,a5,b5,d5,e5,v5] = get(5)
add(s5,c5,a5,b5,d5,e5,v5)
[s6,c6,a6,b6,d6,e6,v6] = get(6)
add(s6,c6,a6,b6,d6,e6,v6)
[s7,c7,a7,b7,d7,e7,v7] = get(7)
add(s7,c7,a7,b7,d7,e7,v7)
[s8,c8,a8,b8,d8,e8,v8] = get(8)
add(s8,c8,a8,b8,d8,e8,v8)
[s9,c9,a9,b9,d9,e9,v9] = get(9)
add(s9,c9,a9,b9,d9,e9,v9)
[s10,c10,a10,b10,d10,e10,v10] = get(10)
add(s10,c10,a10,b10,d10,e10,v10)
[s11,c11,a11,b11,d11,e11,v11] = get(11)
add(s11,c11,a11,b11,d11,e11,v11)
[s12,c12,a12,b12,d12,e12,v12] = get(12)
add(s12,c12,a12,b12,d12,e12,v12)
[s13,c13,a13,b13,d13,e13,v13] = get(13)
add(s13,c13,a13,b13,d13,e13,v13)
[s14,c14,a14,b14,d14,e14,v14] = get(14)
add(s14,c14,a14,b14,d14,e14,v14)
[s15,c15,a15,b15,d15,e15,v15] = get(15)
add(s15,c15,a15,b15,d15,e15,v15)
[s16,c16,a16,b16,d16,e16,v16] = get(16)
add(s16,c16,a16,b16,d16,e16,v16)
[s17,c17,a17,b17,d17,e17,v17] = get(17)
add(s17,c17,a17,b17,d17,e17,v17)
[s18,c18,a18,b18,d18,e18,v18] = get(18)
add(s18,c18,a18,b18,d18,e18,v18)
[s19,c19,a19,b19,d19,e19,v19] = get(19)
add(s19,c19,a19,b19,d19,e19,v19)

// Send the whole list to n8n once per bar close (live bars only)
if barstate.isrealtime
    alert('{"list":[' + array.join(rows, ",") + ']}', alert.freq_once_per_bar_close)
